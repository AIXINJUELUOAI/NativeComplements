<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="${applicationId}.permission.HBM_CONTROL" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.HBM_CONTROL" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application>
        <service android:name=".features.manualhbm.HbmTileService" android:label="@string/manual_hbm_label"
            android:icon="@drawable/ic_manual_hbm" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".features.shade.QsMediaVolumeTile" android:label="@string/qs_media_volume_tile"
            android:icon="@drawable/ic_game_volume_up" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <activity android:name=".features.minusone.MinusOneActivity" android:excludeFromRecents="true"
            android:exported="false" android:theme="@style/MinusOneTheme" />
        <activity-alias android:name="${applicationId}.MinusOneOverlay" android:exported="true"
            android:permission="android.permission.SYSTEM_APPLICATION_OVERLAY"
            android:targetActivity=".features.minusone.MinusOneActivity">
            <intent-filter>
                <action android:name="com.android.launcher3.WINDOW_OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <provider android:name=".features.minusone.MinusOneSettings" android:authorities="${applicationId}.minusone"
            android:exported="true" android:grantUriPermissions="false" />
        <provider android:name=".features.background.BackgroundProvider" android:authorities="${applicationId}.background" android:exported="true" android:directBootAware="true" android:grantUriPermissions="false" />
        <provider android:name=".features.darkaod.DarkAodProvider" android:authorities="${applicationId}.darkaod" android:exported="true" android:directBootAware="true" android:grantUriPermissions="false" />
        <receiver android:name=".core.WindowBackendSelection" android:enabled="false" android:exported="false" />
    </application>
</manifest>
