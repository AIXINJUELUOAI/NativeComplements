+    Object field(Object owner, String name) throws Exception {
+        // Fast path for hot-path fields: avoid string concatenation and map lookup
+        if("mSurfaceControl".equals(name)&&(task.isInstance(owner)||wc.isInstance(owner)))return mSurfaceControl.get(owner);
+        if("mTaskId".equals(name)&&task.isInstance(owner))return mTaskId.get(owner);
