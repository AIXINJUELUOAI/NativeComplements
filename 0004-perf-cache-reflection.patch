+        if("realActivity".equals(name)&&task.isInstance(owner))return realActivity.get(owner);
+        if("packageName".equals(name)&&activity.isInstance(owner))return packageName.get(owner);
+        return field(owner.getClass(), name).get(owner);
+    }
+    Object call(Object owner, String name) throws Exception {
+        // Fast path for hot-path no-arg methods: avoid string concatenation and synchronized map lookup
+        if("getTask".equals(name)&&wc.isInstance(owner))return getTask.invoke(owner);
+        if("getBounds".equals(name)&&wc.isInstance(owner))return getBounds.invoke(owner);
+        if("getDisplayContent".equals(name)&&wc.isInstance(owner))return getDisplayContent.invoke(owner);
+        if("topRunningActivity".equals(name)&&task.isInstance(owner))return topRunningActivity.invoke(owner);
+        if("isAttached".equals(name)&&wc.isInstance(owner))return isAttached.invoke(owner);
+        if("getConfiguration".equals(name)&&wc.isInstance(owner))return getConfiguration.invoke(owner);
+        if("getRequestedOverrideConfiguration".equals(name)&&wc.isInstance(owner))return getRequestedOverrideConfiguration.invoke(owner);
+        if("getWindowingMode".equals(name)&&task.isInstance(owner))return getWindowingMode.invoke(owner);
+        if("isVisibleRequested".equals(name)&&task.isInstance(owner))return isVisibleRequested.invoke(owner);
+        return method(owner.getClass(), name).invoke(owner);
+    }
     Object call(Object owner, String name, Class<?>[] types, Object... args) throws Exception {
